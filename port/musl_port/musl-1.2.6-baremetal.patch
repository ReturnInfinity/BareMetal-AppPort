+	mov %rsi,%rdx   /* a2 = size */
+	mov %rdi,%rsi   /* a1 = base */
+	mov $11,%edi    /* n = SYS_munmap */
+	call __bmos_syscall
+	xor %esi,%esi   /* a1 = exit code 0 */
+	mov $60,%edi    /* n = SYS_exit */
+	call __bmos_syscall

